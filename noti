local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local discord = "https://discord.gg/STKfU9dCP"
local file = "AdNotice.txt"

-- Kiểm tra thời gian hiển thị lại
local lastClose = 0

pcall(function()
    if isfile(file) then
        lastClose = tonumber(readfile(file)) or 0
    end
end)

if os.time() - lastClose < 86400 then
    return
end

