-- Discord button
local discordBtn = Instance.new("TextButton")
discordBtn.Size = UDim2.new(1, -30, 0, 35)
discordBtn.Position = UDim2.new(0, 15, 0, 230)
discordBtn.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
discordBtn.Text = "Discord | Click to Copy"
discordBtn.TextColor3 = Color3.fromRGB(15, 15, 15)
discordBtn.Font = Enum.Font.GothamBold
discordBtn.TextSize = 13
discordBtn.Parent = main

Instance.new("UICorner", discordBtn).CornerRadius = UDim.new(0, 7)

discordBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(discord)
        discordBtn.Text = "Copied Discord Link!"
    else
        discordBtn.Text = discord
    end
end)

-- Countdown
local countdown = Instance.new("TextLabel")
countdown.Size = UDim2.new(1, -30, 0, 25)
countdown.Position = UDim2.new(0, 15, 0, 272)
countdown.BackgroundTransparency = 1
countdown.TextColor3 = Color3.fromRGB(160, 160, 160)
countdown.Font = Enum.Font.Gotham
countdown.TextSize = 11
countdown.Parent = main

-- Close function
local closed = false

local function closeGUI()
    if closed then return end
    closed = true

    pcall(function()
        writefile(file, tostring(os.time()))
    end)

    gui:Destroy()
end

close.MouseButton1Click:Connect(closeGUI)

-- Auto close after 20 seconds
task.spawn(function()
    for i = 20, 1, -1 do
        if closed then return end
        countdown.Text = "Thông báo sẽ tự đóng sau " .. i .. " giây"
        task.wait(1)
    end

    closeGUI()
end)
